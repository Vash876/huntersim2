# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Database Configuration (Development only - direct connection)
VITE_NEON_DATABASE_URL=postgresql://username:password@endpoint.neon.tech/dbname?sslmode=require

# Production API Configuration
VITE_API_URL=https://api.your-domain.com
VITE_ENVIRONMENT=development

# App Configuration
VITE_APP_NAME=CIFI Tools
VITE_APP_URL=https://your-app-domain.com

# Sync Configuration - Manual Only for Free Tier
VITE_SYNC_ENABLED=true
VITE_AUTO_SYNC_ENABLED=false
VITE_EMERGENCY_SYNC_ON_UNLOAD=true
VITE_SYNC_RETRY_ATTEMPTS=3
