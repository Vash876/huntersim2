# Stack Auth Configuration
# Diese Datei ist spezifisch für dein lokales Setup
# Fülle die Werte von deinem Stack Auth Dashboard aus

VITE_STACK_PROJECT_ID=your-stack-project-id-here
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your-publishable-client-key-here
VITE_STACK_BASE_URL=https://app.stack-auth.com

# Optional: Wenn du einen eigenen Stack Auth Server hostest
# VITE_STACK_BASE_URL=https://your-custom-stack-auth-domain.com
