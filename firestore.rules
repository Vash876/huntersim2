rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Profiles ──
    match /users/{userId} {
      // Any authenticated user can read (needed for friend code lookup)
      allow read: if request.auth != null;
      // Only the owner can write; enforce required fields
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'friendCode'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() <= 10;
    }

    // ── Friendships ──
    // Doc ID = sorted "uidA_uidB", users[] array contains both UIDs
    match /friendships/{docId} {
      // Only participants can read (works with array-contains queries)
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
      
      // Create: must be a participant, enforce required fields
      allow create: if request.auth != null 
        && request.auth.uid in request.resource.data.users
        && request.resource.data.keys().hasAll(['from', 'to', 'users', 'status'])
        && request.resource.data.status in ['pending', 'accepted']
        && request.resource.data.users.size() == 2;
      
      // Update: only participants, only status changes allowed
      allow update: if request.auth != null 
        && request.auth.uid in resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt']);
      
      // Delete: only participants
      allow delete: if request.auth != null 
        && request.auth.uid in resource.data.users;
    }

    // ── Shared TR Tracks ──
    match /sharedTracks/{trackId} {
      // Read: any authenticated user (client filters by friend UIDs)
      // Track data is non-sensitive game progress — acceptable tradeoff
      allow read: if request.auth != null;
      
      // Write: only owner, enforce ownerId matches auth, limit data size
      allow create, update: if request.auth != null 
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'ownerName', 'visibility', 'trackMeta'])
        && request.resource.data.visibility in ['friends', 'public', 'unlisted']
        && request.resource.data.entries.size() <= 500;
      
      allow delete: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
    }

    // ── User Backups (Cloud Sync) ──
    match /userBackups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Deny all other paths ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
